#
# The model of mac/omlx-mac.env.example. Keep comments on their own lines:
# kustomize keeps a trailing comment as part of the value.

# Where the proxies fetch the config, tokenizer and chat template from. Pin the
# revision the Macs serve: the "sha" in .dynamo-omlx-download.json of the
# model's directory on a Mac.
OMLX_MODEL_REPO=Jundot/Qwen3.8-Flash-Next-oQ4e-mtp
OMLX_MODEL_REVISION=2615fc0e976e65c2f3b55daca3a948f1cdc5b9f8

# The model name clients request.
SERVED_MODEL_NAME=Qwen3.8-Flash-Next

# The Macs' OMLX_KV_BLOCK_SIZE. A proxy refuses to start on another one.
EXPECT_BLOCK_SIZE=8192

DYN_TOOL_CALL_PARSER=qwen3_coder
DYN_REASONING_PARSER=qwen3
