#
# The model of mac/omlx-mac.env.example. Keep comments on their own lines:
# kustomize keeps a trailing comment as part of the value.

# Where the proxies fetch the config, tokenizer and chat template from. Pin the
# revision the Macs serve: the "sha" in .dynamo-omlx-download.json of the
# model's directory on a Mac.
OMLX_MODEL_REPO=Jundot/Qwen3.8-Flash-Next-oQ4e-mtp
OMLX_MODEL_REVISION=2615fc0e976e65c2f3b55daca3a948f1cdc5b9f8

# The model name clients request.
SERVED_MODEL_NAME=Qwen3.8-Flash-Next

# Where the proxies keep those files under /models, their --model-path. The
# Dynamo frontend picks the image token counter for image-aware KV routing by a
# name in this path, then by the config's model_type. Its registry knows no
# qwen4_exp, and Qwen3.8 uses Qwen3-VL's image processor, so the path names
# qwen3_vl and no other model family.
OMLX_MODEL_DIR=qwen3_vl/Qwen3.8-Flash-Next

# Most pixels of an image, its tokens being pixels / 1024: 2048 x 2048, about
# what oMLX's own API shrinks an image to. Larger images are scaled down to it
# before the frontend counts their tokens and the Macs encode them. Empty keeps
# the model's 16777216 (16384 tokens), which costs a 12-megapixel photo about
# 15 seconds of prefill instead of 2.
OMLX_IMAGE_MAX_PIXELS=4194304

# The Macs' OMLX_KV_BLOCK_SIZE. A proxy refuses to start on another one.
EXPECT_BLOCK_SIZE=8192

DYN_TOOL_CALL_PARSER=qwen3_coder
DYN_REASONING_PARSER=qwen3
