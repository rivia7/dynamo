#
# Workload of run-aiperf.sh; the model comes from the overlay's profile.env.
# Keep comments on their own lines: kustomize keeps a trailing comment as part
# of the value. The defaults take about 40 minutes.

ENDPOINT=omlx-frontend:8000
INPUT_TOKENS=512
OUTPUT_TOKENS=128

# Sweep: the concurrencies, comma-separated; the Macs' oMLX max_num_seqs is the
# useful top. Each one warms up, then runs for BENCHMARK_SECONDS, PROFILE_RUNS
# times; AIPerf's confidence intervals need at least 3 runs.
CONCURRENCY=1,2,4,8
WARMUP_SECONDS=20
BENCHMARK_SECONDS=120
PROFILE_RUNS=3

# Shared-prefix run: its length. The system prompt defaults to two of the Macs'
# blocks (EXPECT_BLOCK_SIZE).
PREFIX_SECONDS=300
# SHARED_PREFIX_TOKENS=16384
